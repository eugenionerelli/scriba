<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Scriba</string>
    <key>CFBundleDisplayName</key>
    <string>Scriba</string>
    <key>CFBundleExecutable</key>
    <string>Scriba</string>
    <key>CFBundleIdentifier</key>
    <string>dev.nerelli.scriba</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Eugenio Nerelli</string>
    <!-- These two strings are what the system prompt shows the person, so they say
         what happens rather than asking for a capability. Both mention that the
         audio stays here, because that is the first thing anybody wonders when an
         application asks to listen. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Scriba records the conversation so it can write down who said what. The audio stays on this Mac.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Scriba uses the speech model built into macOS to turn what it hears into text. Nothing is sent to a server.</string>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
</dict>
</plist>
